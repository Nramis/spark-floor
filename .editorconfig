root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,py,gradle,xml,ps1}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.{java,py,gradle,xml,json,md,properties}]
end_of_line = lf

[*.{bat,ps1}]
end_of_line = crlf

[gradlew]
end_of_line = lf
